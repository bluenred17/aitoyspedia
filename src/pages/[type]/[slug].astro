---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import { getCategoryLabel } from '../../data/categories';
import { getEntryType } from '../../data/entry-types';
import { getCopyText } from '../../lib/copy-text';
import { getAllEntries, type Entry } from '../../lib/entries';
import { formatStars } from '../../lib/format';

export async function getStaticPaths() {
  const all = await getAllEntries();
  return all.map((item) => ({
    params: { type: item.type, slug: item.slug },
    props: {
      item,
      related: item.data.related
        .map((id) => all.find((e) => `${e.type}/${e.slug}` === id))
        .filter((e): e is Entry => !!e),
    },
  }));
}

const { item, related } = Astro.props as { item: Entry; related: Entry[] };
const { data } = item;
const type = getEntryType(item.type)!;
const { Content } = await render(item.entry);
const copyText = getCopyText(item.type, data as Record<string, unknown>);
---

<Base title={data.title} description={data.summary}>
  <div class="mx-auto max-w-3xl">
    <p class="text-sm text-gray-500">
      <a href={`/categories/${data.category}/`} class="text-indigo-600 hover:underline">{getCategoryLabel(data.category)}</a>
      · <a href={`/${item.type}/`} class="hover:underline">{type.label}</a>
    </p>
    <h1 class="mt-1 break-words text-3xl font-bold">{data.title}</h1>
    {typeof data.stars === 'number' && (
      <p class="mt-1 text-sm text-amber-600">★ GitHub Stars: {formatStars(data.stars)}</p>
    )}
    <p class="mt-3 text-gray-600">{data.summary}</p>

    {data.status === 'usang' && (
      <div role="note" class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
        Entri ini ditandai usang. Periksa sumber aslinya sebelum memakainya.
      </div>
    )}

    {copyText && (
      <div class="mt-5 flex items-start justify-between gap-3 rounded-lg bg-gray-900 p-3 text-gray-50">
        <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre text-sm"><code>{copyText}</code></pre>
        <CopyButton text={copyText} label={type.copyLabel} />
      </div>
    )}

    <article class="prose prose-slate mt-8 max-w-none break-words [&_img]:max-w-full [&_pre]:overflow-x-auto [&_table]:block [&_table]:overflow-x-auto">
      <Content />
    </article>

    <div class="mt-8"><EntryMeta entry={item} /></div>

    {related.length > 0 && (
      <section class="mt-8">
        <h2 class="text-lg font-bold">Entri terkait</h2>
        <ul class="mt-2 list-disc pl-5">
          {related.map((r) => <li><a href={r.url} class="text-indigo-600 hover:underline">{r.data.title}</a></li>)}
        </ul>
      </section>
    )}
  </div>
</Base>
