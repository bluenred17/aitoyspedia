---
interface Props {
  text: string;
  label: string;
  class?: string;
}
const { text, label, class: className = '' } = Astro.props;
---

<button
  type="button"
  data-copy-text={text}
  data-label={label}
  class:list={[
    'whitespace-nowrap rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-700',
    className,
  ]}>{label}</button>
